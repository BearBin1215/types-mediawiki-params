{
  "name": "types-mediawiki-params",
  "version": "1.0.0-alpha.1",
  "description": "TypeScript type definitions for MediaWiki Action API request parameters",
  "keywords": [
    "action-api",
    "api-params",
    "mediawiki",
    "types",
    "typescript",
    "wiki"
  ],
  "license": "MIT",
  "author": "BearBin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BearBin1215/types-mediawiki-params.git"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "types-mediawiki": "^2.1.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
